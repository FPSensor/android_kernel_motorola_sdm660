# Common configuration for Motorola sdm630/sdm636/sdm660 devices, on top of
# vendor/sdm660-perf_defconfig. Device specific options go to
# vendor/ext_config/<device>.config.

# Boot image: the Motorola bootloader takes Image.gz-dtb
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_BUILD_ARM64_APPENDED_KERNEL_IMAGE_NAME="Image.gz-dtb"
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES=""
CONFIG_MOTOROLA_DTB=y

# The A/B bootloader passes skip_initramfs on normal boots; use the ramdisk
# as first stage init anyway and tell init to boot Android (not recovery)
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y

# Motorola platform drivers
CONFIG_MOTO_UTAGS=y
CONFIG_MMI_INFO=y
CONFIG_MMI_SYS_TEMP=y
CONFIG_MSM_TZ_LOG=y
CONFIG_SENSORS=y
CONFIG_SENSORS_FPC_1020=y

# Touchscreens (Synaptics or Focaltech depending on the panel)
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_MMI=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_MMI_CORE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_MMI_RMI_DEV=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_MMI_FW_UPDATE=y
CONFIG_TOUCHSCREEN_FOCALTECH_MMI=y
CONFIG_TOUCHSCREEN_FOCALTECH_CORE_MMI=y
CONFIG_TOUCHSCREEN_FOCALTECH_UPGRADE_MMI=y
CONFIG_TOUCHSCREEN_FOCALTECH_UPGRADE_8716_MMI=y

# Wi-Fi is built in
CONFIG_QCA_CLD_WLAN=y
CONFIG_QCA_CLD_WLAN_PROFILE="default"

# Camera: the Motorola mm-camera blobs need the camera_v2-legacy stack and
# the legacy ION ABI
CONFIG_MSMB_CAMERA_LEGACY=y
CONFIG_ION_LEGACY=y

# Filesystems; keep the ext4/f2fs FBE implementation /data was created with
CONFIG_EXT4_ENCRYPTION=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"

# IPsec, required by the Android 17 kernel compatibility matrix
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_XFRM_MIGRATE=y

# Crash logs (ramoops)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_LOG_BUF_SHIFT=20

# Debug UART (node disabled in the DT; used through earlycon on request)
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y

# debugfs, as on the 4.4 kernel, where TRACING selects it (rpm_stats,
# ipc_logging, clk debug_suspend)
CONFIG_DEBUG_FS=y

# Scheduling and performance
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_HZ_300=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# Per-cgroup utilization clamping instead of SchedTune
# CONFIG_SCHED_TUNE is not set
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# Boost the CPU-DDR bus on input and new display frames
CONFIG_DEVFREQ_BOOST=y
CONFIG_DEVFREQ_INPUT_BOOST_DURATION_MS=64
CONFIG_DEVFREQ_WAKE_BOOST_DURATION_MS=0
CONFIG_DEVFREQ_MSM_CPUBW_BOOST_FREQ=3879
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500
CONFIG_ZRAM_WRITEBACK=y
# Multi-generational LRU page reclaim
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
