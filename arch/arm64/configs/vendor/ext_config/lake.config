# Motorola G7 Plus (lake), on top of vendor/sdm660-perf_defconfig and
# vendor/ext_config/moto-sdm660.config. Work in progress: see
# arch/arm64/boot/dts/vendor/qcom/motorola/lake/README.md.

CONFIG_MOTOROLA_LAKE_DTB=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Audio: Cirrus Logic CS47L35 (Madera, SPI + SLIMbus), shared with payton.
# The CS35L41 amplifier driver still has to be ported.
CONFIG_MFD_MADERA=y
CONFIG_MFD_MADERA_SPI=y
CONFIG_MFD_CS47L35=y
CONFIG_PINCTRL_MADERA=y
CONFIG_PINCTRL_CS47L35=y
CONFIG_GPIO_MADERA=y
CONFIG_MADERA_IRQ=y
CONFIG_REGULATOR_ARIZONA_MICSUPP=y
CONFIG_SND_SOC_MADERA=y
CONFIG_SND_SOC_MADERA_SLIMBUS=y
CONFIG_SND_SOC_WM_ADSP=y
CONFIG_SND_SOC_CS47L35=y
CONFIG_EXTCON_MADERA=y
CONFIG_EXTCON_MADERA_INPUT_EVENT=y
CONFIG_MSM_AVTIMER=y
