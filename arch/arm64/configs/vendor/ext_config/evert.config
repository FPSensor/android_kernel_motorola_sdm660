# Motorola G6 Plus (evert), on top of vendor/sdm660-perf_defconfig and
# vendor/ext_config/moto-sdm660.config

CONFIG_MOTOROLA_EVERT_DTB=y

# SAR proximity sensor and flash/torch boost converter
CONFIG_INPUT_SX9310=y
CONFIG_TPS61280=y

# Audio: Cirrus Logic CS47L35 (Madera, SPI + SLIMbus) and CS35L35 amplifier
CONFIG_MFD_MADERA=y
CONFIG_MFD_MADERA_SPI=y
CONFIG_MFD_CS47L35=y
CONFIG_PINCTRL_MADERA=y
CONFIG_PINCTRL_CS47L35=y
CONFIG_GPIO_MADERA=y
CONFIG_MADERA_IRQ=y
CONFIG_REGULATOR_ARIZONA_MICSUPP=y
CONFIG_SND_SOC_MADERA=y
CONFIG_SND_SOC_MADERA_SLIMBUS=y
CONFIG_SND_SOC_WM_ADSP=y
CONFIG_SND_SOC_CS47L35=y
CONFIG_SND_SOC_CS35L35=y
CONFIG_EXTCON_MADERA=y
CONFIG_EXTCON_MADERA_INPUT_EVENT=y
CONFIG_MSM_AVTIMER=y
